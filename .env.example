# ===== Shopify (required) =====
# Your store domain WITHOUT https://
SHOPIFY_STORE_DOMAIN=ookey-2.myshopify.com

# Storefront API token from Shopify Admin -> Headless -> API Storefront
SHOPIFY_STOREFRONT_ACCESS_TOKEN=replace_me

# Shopify Storefront API version (keep in sync with your store)
SHOPIFY_API_VERSION=2024-10

# ===== Backend =====
# If you don't want Mongo for now, set these to dummy or leave blank;
# the app will still serve Shopify endpoints.
MONGO_URL=
DB_NAME=ookei

# ===== Frontend =====
# When running frontend separately, point it to backend:
REACT_APP_BACKEND_URL=http://localhost:8000
